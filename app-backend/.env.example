# Port 5433, not the Postgres default 5432 — avoids colliding with any native/other
# Postgres already listening on 5432 (Docker's -p 5433:5432 maps container 5432 here).
DATABASE_URL="postgresql://skillsim:skillsim@localhost:5433/skillsim"
PORT=4000

# Signs short-lived sandbox:attach JWTs handed to the browser for WS auth
SANDBOX_JWT_SECRET="change-me"
SANDBOX_JWT_TTL_SECONDS=300

# Shared secret for terminal-server -> app-backend service calls (POST /internal/progress)
INTERNAL_SERVICE_SECRET="change-me-too"

# General user session auth
AUTH_JWT_SECRET="change-me-again"
