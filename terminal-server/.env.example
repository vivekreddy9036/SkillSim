PORT=4100

# Must match app-backend's SANDBOX_JWT_SECRET — verifies the short-lived
# sandbox:attach token the browser presents on WS upgrade.
SANDBOX_JWT_SECRET="change-me"

# Must match app-backend's INTERNAL_SERVICE_SECRET — used when POSTing
# validated step results back to app-backend.
INTERNAL_SERVICE_SECRET="change-me-too"
APP_BACKEND_URL="http://localhost:4000"

# Comma-separated list of allowed WS Origins
ALLOWED_ORIGINS="http://localhost:5173"

# Per-container resource caps
CONTAINER_NANO_CPUS=500000000
CONTAINER_MEMORY_BYTES=536870912
CONTAINER_PIDS_LIMIT=128

# Seconds of no terminal input before a session is reaped
IDLE_TIMEOUT_SECONDS=900
IDLE_SWEEP_INTERVAL_SECONDS=60

# Host-wide cap on simultaneously running sandbox containers (R-01 mitigation) —
# new WS upgrades are rejected with 503 once this many sessions are active
MAX_CONCURRENT_SESSIONS=20

# Root path where lab content (Dockerfiles, steps/) lives, used to resolve
# each lab's imageRef to a buildable image name
LABS_DIR="../labs"
